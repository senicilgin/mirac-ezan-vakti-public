<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:background="@drawable/prayer_widget_background">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="HUZUR VAKTİ" android:textColor="#063F35" android:textStyle="bold" android:textSize="18sp" android:gravity="center"/>
<TextView android:id="@+id/widget_location" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#A63A08" android:gravity="center" android:paddingBottom="6dp"/>
<GridLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="2">
<TextView android:layout_width="0dp" android:layout_columnWeight="1" android:text="İmsak" android:textColor="#A63A08"/><TextView android:id="@+id/time_imsak" android:textColor="#063F35" android:textStyle="bold"/><TextView android:layout_width="0dp" android:layout_columnWeight="1" android:text="Güneş" android:textColor="#A63A08"/><TextView android:id="@+id/time_gunes" android:textColor="#063F35" android:textStyle="bold"/><TextView android:layout_width="0dp" android:layout_columnWeight="1" android:text="Öğle" android:textColor="#A63A08"/><TextView android:id="@+id/time_ogle" android:textColor="#063F35" android:textStyle="bold"/><TextView android:layout_width="0dp" android:layout_columnWeight="1" android:text="İkindi" android:textColor="#A63A08"/><TextView android:id="@+id/time_ikindi" android:textColor="#063F35" android:textStyle="bold"/><TextView android:layout_width="0dp" android:layout_columnWeight="1" android:text="Akşam" android:textColor="#A63A08"/><TextView android:id="@+id/time_aksam" android:textColor="#063F35" android:textStyle="bold"/><TextView android:layout_width="0dp" android:layout_columnWeight="1" android:text="Yatsı" android:textColor="#A63A08"/><TextView android:id="@+id/time_yatsi" android:textColor="#063F35" android:textStyle="bold"/>
</GridLayout>
<TextView android:id="@+id/widget_kerahat" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#A63A08" android:textStyle="bold" android:textSize="11sp" android:gravity="center" android:paddingTop="5dp"/>
<TextView android:id="@+id/widget_next" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textStyle="bold" android:gravity="center" android:padding="7dp" android:layout_marginTop="6dp" android:background="#068574"/>
</LinearLayout>
